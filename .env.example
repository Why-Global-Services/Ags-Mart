# Server Configuration
PORT=3333
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://localhost:27017/nature_hunt

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRATION_MINUTES=43200
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Encryption Key
ENCRYPTION_SECRETKEY=your_encryption_secret_key_here

# Razorpay Configuration
RAZORPAY_KEY=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret_key

# Shiprocket Integration
SHIPROCKET_API=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# Shiprocket Webhook Authentication
# Used to authenticate incoming Shiprocket tracking webhooks via the 'x-api-key' header.
# Configure the exact same token in the Shiprocket Dashboard (Settings -> Webhooks -> Add Webhook).
# Webhook URL: https://<your-backend-domain>/v1/shipping/webhook
SHIPROCKET_WEBHOOK_TOKEN=your_shiprocket_webhook_secret_token_here

# Shiprocket Dynamic Shipping Rate & Policy Configuration
# Merchant pickup pincode for courier rate calculation (defaults to Shiprocket account pickup if empty)
SHIPROCKET_PICKUP_PINCODE=600001

# Fallback standard shipping charge when courier rate is unavailable or API fails (defaults to 50)
DEFAULT_SHIPPING_CHARGE=50
